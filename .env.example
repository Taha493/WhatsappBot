# Copy this file to `.env` and fill in the values. Never commit `.env`.

# ── WhatsApp (Baileys) ───────────────────────────────────────────────
# How to link the bot number: "qr" (scan in terminal / at /link) or "pairing" (8-char code)
WA_LINK_METHOD=qr
# Bot's own number in international format without "+", e.g. 923001234567 (only for pairing)
WA_PAIRING_PHONE=
# Optional comma-separated numbers allowed to use the bot (e.g. 923001234567,923331234567).
# Leave empty to allow anyone.
WA_ALLOWLIST=

# ── AI providers ─────────────────────────────────────────────────────
# https://console.groq.com/keys  (main model + voice notes)
GROQ_API_KEY=
# https://aistudio.google.com/apikey  (fallback model)
GOOGLE_GENERATIVE_AI_API_KEY=
# Format "<provider>:<model-id>", provider is "google" or "groq".
# Fallbacks are comma-separated and tried in order (each Groq model has its own free rate limit).
LLM_PRIMARY=groq:openai/gpt-oss-120b
LLM_FALLBACK=groq:openai/gpt-oss-20b,google:gemini-3.5-flash
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ── Database ─────────────────────────────────────────────────────────
# Supabase → Project → Connect → "Session pooler" connection string (port 5432),
# with your database password filled in.
# Leave empty to use a local embedded database in .data/ (fine for trying it out).
DATABASE_URL=

# ── App ──────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Karachi
SCHEDULER_INTERVAL_SECONDS=20
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MINUTES=10
HTTP_PORT=3000
LOG_LEVEL=info

# ── Admin (dashboard + /link page) ───────────────────────────────────
# Log in with user "admin" and this password. Leave empty to disable the admin pages.
ADMIN_PASSWORD=

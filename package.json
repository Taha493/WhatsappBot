{
  "name": "whatsapp-productivity-bot",
  "version": "0.1.0",
  "description": "AI personal productivity assistant on WhatsApp: tasks, reminders and natural language",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "chat": "tsx --env-file-if-exists=.env src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/groq": "^4.0.69",
    "@electric-sql/pglite": "^0.5.11",
    "ai": "^7.0.152",
    "baileys": "7.0.0-rc14",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "p-queue": "^10.0.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rrule": "^2.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
